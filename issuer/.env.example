# Copy to .env and fill in. Never commit .env.
# Stripe test-mode keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# The publishable key, from the same page: the app's embedded card form uses it.
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen --events checkout.session.completed,charge.dispute.created,charge.dispute.closed --forward-to localhost:8890/webhooks/stripe`, or the dashboard's webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...

# Where this service is reached from the app (what the issuer profile publishes).
PUBLIC_URL=http://localhost:8890
PORT=8890
# The origins the app runs at, comma separated, allowed to call this service
# from inside it: the dev server, and in production the Relay app's own
# (Kangaroo's or Tauri's -- check the Origin header its requests send).
APP_ORIGINS=http://localhost:5173

# The issuer's conductor (admin interface) and its installed app.
CONDUCTOR_ADMIN_URL=ws://localhost:8870
ISSUER_APP_ID=dev-issuer
# While people move from the previous version of the network: the issuer's
# app there (MIGRATION.md). Leave unset otherwise.
# PREVIOUS_ISSUER_APP_ID=relay-issuer-v1

# What the issuer publishes. The cash-out fee recovers card and payout costs
# (2.9% + 30c in, 0.25% + 25c out), so adding funds is free.
ISSUER_NAME=Relay Credits
ISSUER_CONTACT=payouts@example.org
PAYOUT_FEE_CENTS=55
PAYOUT_FEE_BASIS_POINTS=325
MIN_PAYOUT_CENTS=1000
PAYOUT_DAYS=2

# Where this service keeps its own records (processed payments, payout accounts).
DB_PATH=./issuer.db
# How often it sweeps for new cash-outs.
SWEEP_SECONDS=30
# How long a recovered account's old key must be quiet before its balance is
# reissued to the new key (days).
RECOVERY_WAIT_DAYS=7
# A recovered balance above this is left for a person to approve (minor units).
RECOVERY_REVIEW_ABOVE_CENTS=50000

# Card risk (see src/risk.ts). How much an account may add, a day and a
# week, growing with its age and completed orders -- a JSON array, lowest
# tier first. Unset, the defaults: $100/$200 new; $300/$1,000 after 3 orders
# and a week; $1,000/$3,000 after 20 orders and a month.
# TOPUP_TIERS=[{"minOrders":0,"minAgeDays":0,"dailyCents":10000,"weeklyCents":20000}]
# How old an account must be before it's paid out to a bank (days). Refunds
# to the cards it paid with aren't held.
PAYOUT_HOLD_DAYS=7
# Card forms one address may open an hour -- against card testing.
TOPUPS_PER_IP_PER_HOUR=20
# Unsigned nonce requests one address may make an hour (each signed request
# needs one).
NONCES_PER_IP_PER_HOUR=120
# Set to 1 behind a proxy that sets X-Forwarded-For (and only then).
TRUST_PROXY=0
