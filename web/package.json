{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:conductor": "node scripts/dev-conductor.mjs",
    "dev:reset": "node scripts/dev-conductor.mjs --reset --seed",
    "backend": "node scripts/backend.mjs",
    "seed": "node scripts/seed.mjs",
    "package": "node scripts/package.mjs",
    "typegen": "cargo run --quiet --manifest-path ../tools/typegen/Cargo.toml",
    "typegen:check": "cargo run --quiet --manifest-path ../tools/typegen/Cargo.toml -- --check",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --import tsx --test test/*.test.ts",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "issuer": "node scripts/issuer.mjs"
  },
  "dependencies": {
    "@holochain/client": "^0.21.0",
    "@msgpack/msgpack": "^3.1.3",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@scure/bip39": "^1.6.0",
    "@stripe/stripe-js": "^7.10.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.4",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@holochain-open-dev/tryorama": "^0.20.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
