{
  "name": "handshake-push",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A HandShake network's push relay: wakes a closed app without learning who asked, or about what.",
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "keys": "node --import tsx scripts/keys.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.2"
  }
}
